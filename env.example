# Cloudflare R2 (from the R2 dashboard → Manage R2 API Tokens)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=idt-media

# Public base URL for reading public files (profile photos, covers,
# product covers). Either R2's "Public Development URL" (r2.dev — fine to
# start with) or, better for production, a custom domain you've connected
# to the bucket via Cloudflare. No trailing slash.
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev

# Must match the projectId in your Firebase config (grok-4)
FIREBASE_PROJECT_ID=grok-4

# Comma-separated list of origins allowed to call this API — your GitHub
# Pages URL(s). Leave unset only for local testing.
ALLOWED_ORIGIN=https://yourname.github.io

PORT=8787
