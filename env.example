# From Cloudflare dashboard -> R2 -> Manage R2 API Tokens -> (your token)
# These are the exact 3 values Cloudflare shows you when you create the token.
R2_ENDPOINT=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# The bucket name you chose when creating it in the R2 dashboard (not given
# to you by the API token -- you pick this yourself, e.g. "idt-media").
R2_BUCKET=idt-media

# Public base URL for reading public files (profile photos, covers,
# product covers, testimonial photos). In the R2 dashboard: your bucket ->
# Settings -> Public access -> enable the r2.dev subdomain, then paste
# that URL here (fine to start with). A custom domain is better for
# production, later. No trailing slash.
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev

# Must match the projectId in your Firebase config (grok-4)
FIREBASE_PROJECT_ID=grok-4

# Comma-separated list of origins allowed to call this API -- your GitHub
# Pages URL(s). Leave unset only for local testing.
ALLOWED_ORIGIN=https://yourname.github.io

PORT=8787
